{
  "name": "marciosequeiros-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run validate:data && tsc --noEmit && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validateData.ts --production",
    "test": "vitest run",
    "test:e2e": "tsx scripts/runE2eTests.ts",
    "audit:perf": "tsx scripts/measureWebVitals.ts",
    "check:links": "tsx scripts/checkLinks.ts",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "npm run validate:data && npm run typecheck && npm run test && npm run build && npm run check:links"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^5.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.65.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
