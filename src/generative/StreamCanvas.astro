---
// StreamCanvas.astro: Visualización interactiva de la arquitectura de streaming reactivo y microservicios
---

<div class="relative w-full h-full min-h-[400px] lg:min-h-[480px] overflow-hidden rounded-2xl border border-border bg-surface/50 backdrop-blur-md shadow-lg" aria-hidden="true">
  <!-- Alternativa estática SVG (para prefers-reduced-motion y modo sin JS) -->
  <svg class="stream-static-fallback absolute inset-0 w-full h-full opacity-35 dark:opacity-45" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 800 500">
    <defs>
      <linearGradient id="streamGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.7"/>
        <stop offset="50%" stop-color="var(--color-accent-hover)" stop-opacity="0.4"/>
        <stop offset="100%" stop-color="var(--color-success)" stop-opacity="0.6"/>
      </linearGradient>
    </defs>
    <!-- Tuberías estáticas -->
    <path d="M 120,140 C 280,140 320,250 400,250 S 520,160 680,160" fill="none" stroke="url(#streamGrad2)" stroke-width="2" stroke-dasharray="6,6"/>
    <path d="M 120,360 C 280,360 320,250 400,250 S 520,340 680,340" fill="none" stroke="url(#streamGrad2)" stroke-width="2" stroke-dasharray="6,6"/>
    <circle cx="120" cy="140" r="14" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="2"/>
    <circle cx="120" cy="360" r="14" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="2"/>
    <circle cx="400" cy="250" r="22" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="3"/>
    <circle cx="680" cy="160" r="16" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="2"/>
    <circle cx="680" cy="340" r="16" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="2"/>
  </svg>

  <!-- Barra de Telemetría Superior del Pipeline -->
  <div class="absolute top-3 inset-x-3 z-20 flex items-center justify-between px-3 py-1.5 rounded-xl bg-bg/80 border border-border text-[11px] font-mono text-text-muted backdrop-blur-sm select-none">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
      <span class="text-text-main font-semibold">REACTIVE STREAM ENGINE</span>
    </div>
    <div class="hidden sm:flex items-center gap-3">
      <span>THROUGHPUT: <strong class="text-accent">&gt; 1,200 msg/s</strong></span>
      <span class="text-border">|</span>
      <span>BACKPRESSURE: <strong class="text-success">0 ms</strong></span>
    </div>
  </div>

  <!-- Canvas interactivo 2D -->
  <canvas id="stream-canvas" class="relative z-10 w-full h-full block pointer-events-none"></canvas>

  <!-- Barra Inferior de Capas de Arquitectura -->
  <div class="absolute bottom-3 inset-x-3 z-20 flex items-center justify-between px-3 py-1.5 rounded-xl bg-bg/80 border border-border text-[10px] font-mono text-text-muted backdrop-blur-sm select-none">
    <span>[1] INGESTA / ORACLE</span>
    <span class="text-accent font-bold">➔ [2] CHUNKS BUFFER</span>
    <span>➔ [3] MICROSERVICES CORE</span>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    #stream-canvas {
      display: none !important;
    }
    .stream-static-fallback {
      display: block !important;
      opacity: 0.6 !important;
    }
  }
</style>

<script>
  import { StreamAnimation } from './StreamAnimation';

  function initStreamCanvas() {
    const canvas = document.getElementById('stream-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    try {
      new StreamAnimation(canvas);
    } catch (e) {
      console.warn('No se pudo inicializar la animación Canvas 2D:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStreamCanvas, { once: true });
  } else {
    initStreamCanvas();
  }
</script>
