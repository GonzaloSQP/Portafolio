---
// ArchitectureFlow.astro: Diagrama visual de flujo de datos y arquitectura de microservicios
interface Props {
  flow: string[];
  title?: string;
}

const {
  flow,
  title = "Topología de Componentes & Pipeline de Datos"
} = Astro.props;
---

<div class="rounded-sm border border-border bg-surface p-5 sm:p-6 space-y-4 shadow-sm">
  <div class="flex items-center gap-2 border-b border-border pb-3">
    <span class="w-1.5 h-1.5 bg-accent"></span>
    <h3 class="text-xs font-mono font-bold text-accent uppercase tracking-wider">
      [ {title} ]
    </h3>
  </div>

  <div class="pt-2 overflow-x-auto">
    <div class="flex flex-col md:flex-row items-stretch md:items-center gap-2 min-w-[540px]">
      {flow.map((step, idx) => (
        <div class="flex-1 flex flex-col md:flex-row items-center gap-2">
          <!-- Bloque de etapa rectangular -->
          <div class="w-full p-3.5 rounded-sm bg-bg border border-border text-center space-y-1 shadow-sm">
            <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded-sm bg-accent-bg text-accent border border-accent/20 uppercase">
              FASE 0{idx + 1}
            </span>
            <div class="text-xs sm:text-sm font-bold text-text-main mt-1 font-mono">
              {step}
            </div>
          </div>

          <!-- Flecha conectora recta (salvo en el último elemento) -->
          {idx < flow.length - 1 && (
            <div class="text-accent shrink-0 flex items-center justify-center rotate-90 md:rotate-0 my-1 md:my-0">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</div>
