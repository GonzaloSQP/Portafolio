---
import type { Project } from '../schemas/portfolioSchema';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article
  class={`group relative flex flex-col justify-between rounded-2xl border border-border bg-surface p-6 sm:p-8 hover:border-accent/50 transition-all duration-200 hover:shadow-lg ${
    featured ? 'lg:col-span-2' : ''
  }`}
  aria-labelledby={`project-title-${project.id}`}
>
  <div>
    <!-- Encabezado de la tarjeta: Categoría y Estado -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <span class="text-xs font-mono font-medium px-2.5 py-1 rounded-full bg-accent/10 text-accent border border-accent/20">
        {project.category}
      </span>

      <!-- Estado accesible con icono y texto -->
      <div class="inline-flex items-center gap-1.5 text-xs font-medium text-success px-2.5 py-0.5 rounded-full bg-success/10 border border-success/20">
        <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
        <span class="capitalize">{project.status}</span>
      </div>
    </div>

    <!-- Título con enlace principal único -->
    <h3
      id={`project-title-${project.id}`}
      class="text-xl sm:text-2xl font-bold tracking-tight text-text-main group-hover:text-accent transition-colors"
    >
      <a href={`/proyectos/${project.id}`} class="focus-visible:outline-accent">
        <span class="absolute inset-0 z-10" aria-hidden="true"></span>
        {project.title}
      </a>
    </h3>

    <!-- Resumen -->
    <p class="mt-3 text-sm sm:text-base text-text-muted leading-relaxed">
      {project.summary}
    </p>

    <!-- Resultados Verificables Destacados -->
    <div class="mt-4 pt-4 border-t border-border/60">
      <h4 class="text-xs font-bold font-mono text-text-main uppercase tracking-wider mb-2">
        Impacto y Resultados Clave:
      </h4>
      <ul class="space-y-1.5 text-xs text-text-muted">
        {project.results.slice(0, 2).map((res) => (
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{res}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Pie de Tarjeta: Stack y Enlace -->
  <div class="mt-6 pt-4 border-t border-border flex flex-wrap items-center justify-between gap-3">
    <!-- Tecnologías -->
    <div class="flex flex-wrap gap-1.5">
      {project.technologies.slice(0, 4).map((tech) => (
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-surface-hover text-text-muted border border-border">
          {tech}
        </span>
      ))}
      {project.technologies.length > 4 && (
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-surface-hover text-text-muted">
          +{project.technologies.length - 4}
        </span>
      )}
    </div>

    <!-- Indicador de navegación -->
    <span class="inline-flex items-center text-xs font-bold text-accent group-hover:translate-x-1 transition-transform">
      Ver caso de estudio
      <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</article>

