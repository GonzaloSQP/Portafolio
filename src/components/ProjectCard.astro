---
import type { Project } from '../schemas/portfolioSchema';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;

const statusStyles: Record<string, { bg: string; text: string; dot: string }> = {
  'En Producción': { bg: 'bg-success/10', text: 'text-success', dot: 'bg-success' },
  'Entregado': { bg: 'bg-accent/10', text: 'text-accent', dot: 'bg-accent' },
  'Confidencial (Bajo NDA)': { bg: 'bg-amber-500/10', text: 'text-amber-500', dot: 'bg-amber-500' },
  'activo': { bg: 'bg-success/10', text: 'text-success', dot: 'bg-success' },
};

const currentStatus = statusStyles[project.status] || statusStyles['En Producción'];
---

<article
  class={`group relative flex flex-col justify-between rounded-2xl border border-border bg-surface p-6 sm:p-8 hover:border-accent/50 transition-all duration-200 hover:shadow-xl ${
    featured ? 'lg:col-span-2' : ''
  }`}
  aria-labelledby={`project-title-${project.id}`}
>
  <div>
    <!-- Encabezado de la tarjeta: Categoría y Estado Significativo -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <span class="text-xs font-mono font-medium px-2.5 py-1 rounded-full bg-accent/10 text-accent border border-accent/20">
        {project.category}
      </span>

      <!-- Estado con significado técnico real -->
      <div class={`inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-0.5 rounded-full border border-current/20 ${currentStatus.bg} ${currentStatus.text}`}>
        <span class={`w-1.5 h-1.5 rounded-full ${currentStatus.dot}`}></span>
        <span>{project.statusDetail || project.status}</span>
      </div>
    </div>

    <!-- Título con enlace principal único -->
    <h3
      id={`project-title-${project.id}`}
      class="text-xl sm:text-2xl font-bold tracking-tight text-text-main group-hover:text-accent transition-colors"
    >
      <a href={`/proyectos/${project.id}`} class="focus-visible:outline-accent">
        <span class="absolute inset-0 z-10" aria-hidden="true"></span>
        {project.title}
      </a>
    </h3>

    <!-- Resumen -->
    <p class="mt-3 text-sm sm:text-base text-text-muted leading-relaxed">
      {project.summary}
    </p>

    <!-- Línea Base vs Resultado (Si existe) -->
    {project.baseline && project.metricOutcome && (
      <div class="mt-4 p-3.5 rounded-xl bg-bg border border-border/80 text-xs font-mono space-y-1.5">
        <div class="flex items-start gap-1.5 text-text-muted">
          <span class="text-error font-bold">Línea base:</span>
          <span>{project.baseline}</span>
        </div>
        <div class="flex items-start gap-1.5 text-text-main font-semibold">
          <span class="text-success font-bold">Resultado:</span>
          <span class="text-success">{project.metricOutcome}</span>
        </div>
      </div>
    )}

    <!-- Resultados Verificables Destacados -->
    <div class="mt-4 pt-3 border-t border-border/60">
      <h4 class="text-xs font-bold font-mono text-text-main uppercase tracking-wider mb-2">
        Evidencia y Métricas Comprobadas:
      </h4>
      <ul class="space-y-1.5 text-xs text-text-muted">
        {project.results.slice(0, 2).map((res) => (
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{res}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Pie de Tarjeta: Stack Completo y CTA con Contexto -->
  <div class="mt-6 pt-4 border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <!-- Tecnologías -->
    <div class="flex flex-wrap gap-1.5">
      {project.technologies.map((tech) => (
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-surface-hover text-text-muted border border-border">
          {tech}
        </span>
      ))}
    </div>

    <!-- Indicador de navegación con contexto específico -->
    <span class="inline-flex items-center text-xs font-bold text-accent group-hover:translate-x-1 transition-transform shrink-0 self-end sm:self-auto">
      {project.ctaText || "Ver arquitectura y resultados →"}
    </span>
  </div>
</article>
