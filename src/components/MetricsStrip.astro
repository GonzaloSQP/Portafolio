---
// MetricsStrip.astro: Rail de telemetría de ingeniería de alta precisión y métricas verificadas con contexto de medición
const metrics = [
  {
    value: '> 1,000,000',
    unit: 'registros',
    subtext: 'En menos de 15 minutos',
    badge: 'SYS_01 · STREAMING',
    baseline: 'Antes: 4h 15m (Monolito VB)',
    outcome: 'Ahora: 14m 20s (Jakarta EE)',
    method: 'Oracle SQL Trace · JVM Heap',
    desc: 'Streaming reactivo por cursores JDBC con FetchSize de 2,500 y heap acotado a 380 MB.',
  },
  {
    value: '30+',
    unit: 'empresas',
    subtext: 'Facturación Centralizada',
    badge: 'SYS_02 · FISCAL',
    baseline: 'Antes: ERPs aislados (24.8% error)',
    outcome: 'Ahora: 30+ empresas (<1.2% error)',
    method: 'PostgreSQL · Auditoría CDR',
    desc: 'Gestión fiscal multi-tenant con aislamiento criptográfico de certificados X.509.',
  },
  {
    value: '< 120 ms',
    unit: 'latencia',
    subtext: 'Consultas Idempotentes',
    badge: 'SYS_03 · CONCURRENCY',
    baseline: 'Antes: 2,400 ms (sin caché)',
    outcome: 'Ahora: 95 ms (Redis en memoria)',
    method: 'Cloudflare APM · SLA 99.8%',
    desc: 'Microservicios REST para DNI, RUC, Placas y SOAT con balanceo y TTL adaptativo.',
  },
  {
    value: '< 1.2%',
    unit: 'tasa rechazo',
    subtext: 'Pre-Auditoría SUNAT',
    badge: 'SYS_04 · COMPLIANCE',
    baseline: 'Antes: 24.8% rechazados por SUNAT',
    outcome: 'Ahora: 95.2% reducción de fallos',
    method: 'Validación en memoria UBL 2.1',
    desc: 'Pre-auditoría de catálogos y aritmética previo a la firma digital y envío SOAP.',
  }
];
---

<section class="border-y border-border bg-surface" aria-label="Métricas técnicas comprobadas">
  <div class="max-w-content mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-border">
      {metrics.map((m) => (
        <div class="p-4 sm:p-5 flex flex-col justify-between hover:bg-surface-hover/30 transition-colors">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 rounded-sm bg-accent-bg text-accent border border-accent/20">
                {m.badge}
              </span>
              <span class="w-1.5 h-1.5 rounded-none bg-accent/60" aria-hidden="true"></span>
            </div>

            <div class="flex items-baseline gap-1.5">
              <span class="text-2xl sm:text-3xl font-black font-mono tracking-tight text-text-main tabular-nums">
                {m.value}
              </span>
              <span class="text-xs font-mono font-bold text-accent uppercase">
                {m.unit}
              </span>
            </div>

            <div class="text-xs font-bold text-text-main mt-0.5 uppercase tracking-wide">
              {m.subtext}
            </div>

            <!-- Contexto empírico de medición: Línea Base, Resultado y Método -->
            <div class="mt-3 p-2 rounded-sm bg-bg border border-border/70 font-mono text-[11px] space-y-1">
              <div class="flex items-center justify-between gap-1 text-text-muted">
                <span class="text-error font-bold text-[10px] uppercase shrink-0">[ANTES]:</span>
                <span class="truncate">{m.baseline}</span>
              </div>
              <div class="flex items-center justify-between gap-1 text-text-main font-semibold">
                <span class="text-success font-bold text-[10px] uppercase shrink-0">[AHORA]:</span>
                <span class="text-success truncate">{m.outcome}</span>
              </div>
              <div class="pt-1 border-t border-border/50 text-[10px] text-text-dim flex items-center justify-between">
                <span class="uppercase">Medición:</span>
                <span class="text-accent truncate">{m.method}</span>
              </div>
            </div>
          </div>

          <p class="text-xs text-text-muted mt-3 leading-relaxed border-t border-border/50 pt-2 font-sans">
            {m.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
