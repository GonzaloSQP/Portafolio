---
import { portfolioData } from '../data/portfolioData';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface/50 text-text-muted transition-colors">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Identidad y Filosofía -->
      <div class="text-center md:text-left space-y-1.5">
        <div class="flex items-center justify-center md:justify-start gap-2">
          <span class="w-6 h-6 rounded bg-accent text-bg flex items-center justify-center font-mono text-xs font-bold">
            MS
          </span>
          <span class="font-bold text-text-main text-sm">
            {portfolioData.name}
          </span>
        </div>
        <p class="text-xs text-text-muted max-w-md">
          Arquitectura de software de alto rendimiento, microservicios reactivos y facturación electrónica a gran escala.
        </p>
      </div>

      <!-- Certificación Oficial -->
      <div class="flex items-center gap-3 px-3 py-2 rounded-lg bg-surface border border-border text-xs">
        <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span class="font-medium text-text-main">
          PMI Project Management Ready® (Licencia: {portfolioData.certifications[0].credentialId})
        </span>
      </div>

      <!-- Enlaces Externos Reales -->
      <div class="flex items-center gap-4">
        <a
          href={portfolioData.contact.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg hover:text-accent hover:bg-surface border border-transparent hover:border-border transition-colors"
          aria-label="Perfil de GitHub de Marcio Sequeiros"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <a
          href={portfolioData.contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg hover:text-accent hover:bg-surface border border-transparent hover:border-border transition-colors"
          aria-label="Perfil de LinkedIn de Marcio Sequeiros"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
        </a>

        <a
          href={`mailto:${portfolioData.contact.email}`}
          class="p-2 rounded-lg hover:text-accent hover:bg-surface border border-transparent hover:border-border transition-colors"
          aria-label="Enviar correo electrónico directo"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between text-xs text-text-muted gap-4">
      <p>© {currentYear} Marcio Gonzalo Sequeiros Palomino. Todos los derechos reservados.</p>
      <p class="font-mono">Arquitectura estática SSG · Zero-cost Cloudflare Edge</p>
    </div>
  </div>
</footer>

