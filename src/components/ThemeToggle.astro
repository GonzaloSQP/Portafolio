---
// ThemeToggle.astro: Selector de tema triple (Sistema / Claro / Oscuro)
---

<div class="theme-switcher relative inline-flex items-center p-1 rounded-full bg-surface border border-border" role="group" aria-label="Selector de tema de color">
  <button
    type="button"
    data-theme-value="light"
    class="theme-btn relative p-1.5 rounded-full text-text-muted hover:text-text-main focus-visible:outline-accent transition-colors"
    aria-label="Activar tema claro"
    title="Tema claro"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
  </button>

  <button
    type="button"
    data-theme-value="system"
    class="theme-btn relative p-1.5 rounded-full text-text-muted hover:text-text-main focus-visible:outline-accent transition-colors"
    aria-label="Usar tema del sistema"
    title="Tema del sistema"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
  </button>

  <button
    type="button"
    data-theme-value="dark"
    class="theme-btn relative p-1.5 rounded-full text-text-muted hover:text-text-main focus-visible:outline-accent transition-colors"
    aria-label="Activar tema oscuro"
    title="Tema oscuro"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
  </button>
</div>

<script>
  function setupThemeToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-btn');
    const root = document.documentElement;

    function getStoredTheme(): 'light' | 'dark' | 'system' {
      try {
        const stored = localStorage.getItem('theme-preference');
        if (stored === 'light' || stored === 'dark' || stored === 'system') {
          return stored;
        }
      } catch (e) {
        // En caso de que localStorage esté bloqueado por privacidad
      }
      return 'system';
    }

    function applyTheme(theme: 'light' | 'dark' | 'system') {
      try {
        localStorage.setItem('theme-preference', theme);
      } catch (e) {
        // Manejo tolerante a excepciones de almacenamiento privado
      }

      let resolvedTheme = theme;
      if (theme === 'system') {
        resolvedTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      root.setAttribute('data-theme', resolvedTheme);

      // Actualizar estado visual de los botones
      buttons.forEach((btn) => {
        const val = btn.getAttribute('data-theme-value');
        if (val === theme) {
          btn.classList.add('bg-accent/15', 'text-accent', 'font-bold');
          btn.classList.remove('text-text-muted');
          btn.setAttribute('aria-pressed', 'true');
        } else {
          btn.classList.remove('bg-accent/15', 'text-accent', 'font-bold');
          btn.classList.add('text-text-muted');
          btn.setAttribute('aria-pressed', 'false');
        }
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-theme-value') as 'light' | 'dark' | 'system';
        if (val) applyTheme(val);
      });
    });

    // Escuchar cambios de color-scheme del sistema operativo cuando está en modo sistema
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (getStoredTheme() === 'system') {
        applyTheme('system');
      }
    });

    // Sincronizar estado inicial en el componente
    applyTheme(getStoredTheme());
  }

  // Ejecutar inmediatamente
  setupThemeToggle();
</script>

