---
---

<section id="demo" class="py-12 sm:py-16 border-b border-border bg-surface/40" aria-labelledby="demo-title">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <div class="border-b border-border pb-4">
      <span class="text-xs font-mono text-accent font-bold uppercase tracking-wider">[ PRUÉBALO EN 10 SEGUNDOS ]</span>
      <h2 id="demo-title" class="text-2xl sm:text-3xl font-black text-text-main tracking-tight mt-1">Validador en vivo: RUC, DNI e IGV</h2>
      <p class="text-xs sm:text-sm text-text-muted mt-1 max-w-2xl">La misma idea de la pre-auditoría que uso antes de firmar un comprobante: validar en el navegador, antes de enviar a SUNAT. Sin registro, sin enviar tus datos a ningún servidor.</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
      <div class="space-y-4">
        <div class="flex gap-2" role="tablist" aria-label="Tipo de validación">
          <button type="button" class="demo-tab px-3 py-2 rounded-sm bg-accent text-bg font-mono text-xs font-bold uppercase" data-tab="ruc" role="tab" aria-selected="true">RUC</button>
          <button type="button" class="demo-tab px-3 py-2 rounded-sm bg-bg border border-border text-text-main font-mono text-xs font-bold uppercase" data-tab="dni" role="tab" aria-selected="false">DNI</button>
          <button type="button" class="demo-tab px-3 py-2 rounded-sm bg-bg border border-border text-text-main font-mono text-xs font-bold uppercase" data-tab="igv" role="tab" aria-selected="false">Comprobante IGV</button>
        </div>
        <div id="panel-ruc" class="demo-panel space-y-3">
          <label class="block text-xs font-mono font-bold uppercase text-text-main" for="demo-ruc">RUC (11 dígitos)</label>
          <div class="flex gap-2"><input id="demo-ruc" inputmode="numeric" maxlength="11" placeholder="Ej. 20123456786" class="flex-1 px-3 py-2 rounded-sm bg-bg border border-border text-text-main" /><button id="btn-ruc" type="button" class="px-4 py-2 rounded-sm bg-accent text-bg font-mono text-xs font-bold uppercase">Validar</button></div>
        </div>
        <div id="panel-dni" class="demo-panel space-y-3 hidden">
          <label class="block text-xs font-mono font-bold uppercase text-text-main" for="demo-dni">DNI (8 dígitos)</label>
          <div class="flex gap-2"><input id="demo-dni" inputmode="numeric" maxlength="8" placeholder="Ej. 12345678" class="flex-1 px-3 py-2 rounded-sm bg-bg border border-border text-text-main" /><button id="btn-dni" type="button" class="px-4 py-2 rounded-sm bg-accent text-bg font-mono text-xs font-bold uppercase">Validar</button></div>
        </div>
        <div id="panel-igv" class="demo-panel space-y-3 hidden">
          <label class="block text-xs font-mono font-bold uppercase text-text-main" for="demo-subtotal">Subtotal sin IGV (S/)</label>
          <input id="demo-subtotal" inputmode="decimal" placeholder="Ej. 100.00" class="w-full px-3 py-2 rounded-sm bg-bg border border-border text-text-main" />
          <label class="block text-xs font-mono font-bold uppercase text-text-main" for="demo-total">Total que quieres emitir (S/)</label>
          <div class="flex gap-2"><input id="demo-total" inputmode="decimal" placeholder="Ej. 118.00" class="flex-1 px-3 py-2 rounded-sm bg-bg border border-border text-text-main" /><button id="btn-igv" type="button" class="px-4 py-2 rounded-sm bg-accent text-bg font-mono text-xs font-bold uppercase">Validar</button></div>
        </div>
        <div id="demo-result" aria-live="polite" class="hidden p-4 rounded-sm border font-mono text-sm"></div>
        <p class="text-[11px] text-text-muted">Demo de validación de formato y cálculo en tu navegador. No es una consulta en vivo a SUNAT/RENIEC: eso requiere una API protegida contra abuso (límite de peticiones + Turnstile). Si la necesitas en producción, te la integro así.</p>
      </div>
      <div class="p-5 rounded-sm bg-bg border border-border space-y-3">
        <h3 class="text-sm font-bold text-text-main">Qué valida (como una pre-auditoría)</h3>
        <ul class="text-sm text-text-muted space-y-2 list-disc list-inside">
          <li><strong class="text-text-main">RUC:</strong> longitud 11 y dígito verificador con el algoritmo de SUNAT.</li>
          <li><strong class="text-text-main">DNI:</strong> longitud 8 y formato numérico.</li>
          <li><strong class="text-text-main">IGV:</strong> subtotal + 18% redondeado a 2 decimales, comparado con el total a emitir.</li>
        </ul>
        <div class="pt-2 border-t border-border">
          <p class="text-xs text-text-muted">¿Quieres esto dentro de tu sistema, con consulta oficial y registro de CDR?</p>
          <a href="https://wa.me/51929803589?text=Hola%20Marcio%2C%20prob%C3%A9%20tu%20validador%20y%20quiero%20integrarlo%20a%20mi%20sistema." target="_blank" rel="noopener noreferrer" class="inline-flex mt-2 px-4 py-2 rounded-sm bg-accent text-bg font-mono text-xs font-bold uppercase">Quiero integrarlo →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.demo-tab');
  tabs.forEach((btn) => { btn.addEventListener('click', () => { tabs.forEach((b) => { b.className = 'demo-tab px-3 py-2 rounded-sm bg-bg border border-border text-text-main font-mono text-xs font-bold uppercase'; b.setAttribute('aria-selected','false'); }); btn.className = 'demo-tab px-3 py-2 rounded-sm bg-accent text-bg font-mono text-xs font-bold uppercase'; btn.setAttribute('aria-selected','true'); document.querySelectorAll('.demo-panel').forEach((p) => p.classList.add('hidden')); const panel = document.getElementById('panel-' + btn.getAttribute('data-tab')); if (panel) panel.classList.remove('hidden'); }); });
  function show(ok, title, detail) { const box = document.getElementById('demo-result'); if (!box) return; box.classList.remove('hidden'); box.className = 'p-4 rounded-sm border font-mono text-sm ' + (ok ? 'bg-success/10 border-success/40 text-success' : 'bg-error/10 border-error/40 text-error'); box.innerHTML = '<strong>' + (ok ? '✓ PASA — ' : '✕ REVISAR — ') + title + '</strong><div class="mt-1 text-text-main text-xs">' + detail + '</div>'; }
  function validRUC(ruc) { if (!/^\d{11}$/.test(ruc)) return false; const w = [5,4,3,2,7,6,5,4,3,2]; let s = 0; for (let i = 0; i < 10; i++) s += Number(ruc[i]) * w[i]; let c = 11 - (s % 11); if (c === 10) c = 0; else if (c === 11) c = 1; return c === Number(ruc[10]); }
  document.getElementById('btn-ruc')?.addEventListener('click', () => { const v = (document.getElementById('demo-ruc') as HTMLInputElement).value.trim(); show(validRUC(v), 'RUC ' + v, validRUC(v) ? 'Formato y dígito verificador correctos. Falta consultar razón social/estado en SUNAT para emitir.' : 'Revisa los 11 dígitos: el dígito verificador no coincide.'); });
  document.getElementById('btn-dni')?.addEventListener('click', () => { const v = (document.getElementById('demo-dni') as HTMLInputElement).value.trim(); const ok = /^\d{8}$/.test(v) && !/^(\d)\1{7}$/.test(v); show(ok, 'DNI ' + v, ok ? 'Formato de 8 dígitos correcto. Falta validar contra RENIEC para confirmar identidad.' : 'DNI inválido: debe tener exactamente 8 dígitos numéricos.'); });
  document.getElementById('btn-igv')?.addEventListener('click', () => { const sub = parseFloat((document.getElementById('demo-subtotal') as HTMLInputElement).value); const tot = parseFloat((document.getElementById('demo-total') as HTMLInputElement).value); if (isNaN(sub) || isNaN(tot)) { show(false, 'Datos incompletos', 'Ingresa subtotal y total numéricos.'); return; } const expected = Math.round((sub * 1.18) * 100) / 100; const ok = Math.abs(expected - tot) <= 0.01; show(ok, 'Total esperado S/ ' + expected.toFixed(2), ok ? 'El total coincide con subtotal + IGV 18%. Listo para el siguiente paso de validación.' : 'Diferencia de S/ ' + Math.abs(expected - tot).toFixed(2) + '. En SUNAT esto se observa: corrige antes de firmar.'); });
</script>
