---
import { portfolioData } from '../data/portfolioData';
import StreamCanvas from '../generative/StreamCanvas.astro';

const coreStack = [
  'Go',
  'Jakarta EE',
  'Python / FastAPI',
  '.NET 8 / C#',
  'PostgreSQL / pgvector',
  'Oracle SQL',
  'Redis',
  'Docker'
];
---

<section class="relative py-10 lg:py-14 border-b border-border bg-bg" aria-labelledby="hero-title">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      <!-- Columna Izquierda: Información de Arquitectura -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <!-- Tag Técnico Unificado -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-sm bg-accent-bg border border-accent/30 text-accent text-xs font-mono font-bold tracking-wider uppercase">
              <span class="w-1.5 h-1.5 bg-accent"></span>
              <span>{portfolioData.title}</span>
            </span>
            <span class="text-xs font-mono text-text-muted hidden sm:inline">
              // CUSCO, PERÚ · DISPONIBILIDAD INMEDIATA
            </span>
          </div>

          <!-- Titular Orientado a Resultados Concretos -->
          <h1
            id="hero-title"
            class="text-3xl sm:text-5xl lg:text-[50px] font-black tracking-tight text-text-main leading-[1.12]"
          >
            Sistemas de facturación y datos masivos que <span class="text-accent">no se caen</span> ante millones de registros.
          </h1>

          <!-- Resumen Conciso y Directo -->
          <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl font-sans">
            Arquitecto de software especializado en modernización de plataformas críticas: streaming reactivo con Oracle SQL y Jakarta EE (<strong class="text-text-main font-semibold">+1M registros en &lt;15 min</strong>), centralización tributaria SUNAT para <strong class="text-text-main font-semibold">+30 empresas</strong> en .NET 8, y microservicios modulares en Go con Clean Architecture.
          </p>
        </div>

        <!-- Acciones Directas con CTA Primario Claro y WhatsApp de Alta Conversión -->
        <div class="space-y-4 pt-1">
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/proyectos"
              class="px-5 py-2.5 rounded-sm bg-accent text-bg font-mono text-xs font-black uppercase tracking-wider hover:bg-accent-hover transition-colors inline-flex items-center gap-2 focus-visible:outline-accent shadow-sm"
            >
              <span>Ver Arquitecturas en Producción →</span>
            </a>

            <a
              href={`https://wa.me/51929803589?text=${encodeURIComponent('Hola Marcio, vi tu portafolio de arquitectura y me gustaría conversar sobre un proyecto.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2.5 rounded-sm bg-surface border border-border text-text-main font-mono text-xs font-bold uppercase tracking-wider hover:border-success hover:text-success transition-colors inline-flex items-center gap-2 focus-visible:outline-accent"
            >
              <span class="w-2 h-2 rounded-full bg-success"></span>
              <span>WhatsApp Directo</span>
            </a>

            <a
              href="/cv"
              class="px-3.5 py-2.5 rounded-sm text-text-muted hover:text-text-main font-mono text-xs font-semibold uppercase tracking-wider hover:bg-surface-hover/50 transition-colors focus-visible:outline-accent inline-flex items-center gap-1.5"
            >
              <span>Currículum (PDF)</span>
              <span class="text-accent">↗</span>
            </a>
          </div>

          <!-- Stack Core con Chips Rectangulares -->
          <div class="pt-2 border-t border-border/60 flex flex-wrap items-center gap-1.5 text-xs font-mono">
            <span class="text-text-main font-bold uppercase text-[11px] mr-1">Stack:</span>
            {coreStack.map((tech) => (
              <span class="px-2 py-0.5 rounded-sm bg-surface border border-border text-text-muted font-mono text-[11px]">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Panel de Telemetría y Pipeline Visual Interactivo -->
      <div class="lg:col-span-5 flex flex-col justify-start">
        <StreamCanvas />
      </div>
    </div>
  </div>
</section>
