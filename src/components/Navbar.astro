---
import ThemeToggle from './ThemeToggle.astro';
import CommandMenu from './CommandMenu.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/proyectos', label: 'Proyectos & Arquitectura' },
  { href: '/blog', label: 'Blog & Notas' },
  { href: '/sobre-mi', label: 'Sobre Mí' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-bg/95 backdrop-blur-md transition-colors">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between">
    <!-- Logotipo / Identidad Recta y Refinada -->
    <a
      href="/"
      class="group flex items-center gap-2.5 font-bold tracking-tight text-text-main focus-visible:outline-accent"
      aria-label="Marcio Sequeiros - Inicio"
    >
      <span class="w-7 h-7 rounded-sm bg-accent text-bg flex items-center justify-center font-mono text-xs font-black shadow-sm group-hover:bg-accent-hover transition-colors">
        MS
      </span>
      <div class="flex flex-col">
        <span class="text-sm font-black leading-tight tracking-tight">Marcio Sequeiros</span>
        <span class="text-[11px] font-mono text-accent leading-none hidden sm:block">Software Architect</span>
      </div>
    </a>

    <!-- Navegación de Escritorio Recta y de Alto Contraste -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
      {navLinks.map((link) => {
        const isActive =
          currentPath === link.href ||
          (link.href === '/blog' && (currentPath.startsWith('/blog') || currentPath.startsWith('/notas'))) ||
          (link.href !== '/' && link.href !== '/blog' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-sm text-sm font-medium transition-colors ${
              isActive
                ? 'text-accent bg-accent-bg border-b-2 border-accent font-semibold'
                : 'text-text-muted hover:text-text-main hover:bg-surface-hover/70'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Acciones derechas (Buscador Ctrl+K + Tema + Botón móvil) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Botón de Búsqueda Rápida Spotlight -->
      <button
        type="button"
        class="cmd-trigger-btn flex items-center gap-2 px-2.5 py-1 rounded-sm border border-border bg-surface text-text-muted hover:text-text-main hover:border-accent text-xs font-mono transition-colors"
        aria-label="Abrir buscador rápido (Ctrl+K)"
      >
        <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Buscar</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.2 rounded-sm bg-surface-hover border border-border text-[10px] font-mono text-text-muted">
          Ctrl K
        </kbd>
      </button>

      <ThemeToggle />

      <!-- Botón Menú Móvil -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-sm text-text-muted hover:text-text-main hover:bg-surface border border-border focus-visible:outline-accent"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación móvil"
      >
        <svg id="menu-icon-open" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú Móvil Desplegable Accesible -->
  <nav
    id="mobile-menu"
    class="md:hidden hidden border-b border-border bg-surface px-4 pt-2 pb-4 space-y-1 shadow-lg"
    aria-label="Menú de navegación móvil"
  >
    {navLinks.map((link) => {
      const isActive =
        currentPath === link.href ||
        (link.href === '/blog' && (currentPath.startsWith('/blog') || currentPath.startsWith('/notas'))) ||
        (link.href !== '/' && link.href !== '/blog' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`mobile-nav-link block px-3 py-2.5 rounded-sm text-base font-medium transition-colors ${
            isActive
              ? 'text-accent bg-accent-bg font-semibold'
              : 'text-text-muted hover:text-text-main hover:bg-surface-hover'
          }`}
          aria-current={isActive ? 'page' : undefined}
        >
          {link.label}
        </a>
      );
    })}
  </nav>
</header>

<CommandMenu />

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (!btn || !menu || !iconOpen || !iconClose) return;

    function toggleMenu(open?: boolean) {
      const isOpen = open !== undefined ? open : menu?.classList.contains('hidden');
      if (isOpen) {
        menu?.classList.remove('hidden');
        btn?.setAttribute('aria-expanded', 'true');
        btn?.setAttribute('aria-label', 'Cerrar menú de navegación móvil');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
      } else {
        menu?.classList.add('hidden');
        btn?.setAttribute('aria-expanded', 'false');
        btn?.setAttribute('aria-label', 'Abrir menú de navegación móvil');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      }
    }

    btn.addEventListener('click', () => toggleMenu());

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        toggleMenu(false);
        btn.focus();
      }
    });

    links.forEach((l) => {
      l.addEventListener('click', () => toggleMenu(false));
    });
  }

  setupMobileMenu();
</script>
