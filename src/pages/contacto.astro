---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolioData';
---

<BaseLayout
  title={`Contacto Directo | ${portfolioData.name}`}
  description={`Canales directos de contacto profesional con ${portfolioData.name}. Correo electrónico, WhatsApp y perfiles técnicos oficiales.`}
  currentPath="/contacto"
>
  <div class="py-12 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Encabezado -->
      <header class="space-y-4 text-center">
        <span class="text-xs font-mono text-accent font-semibold tracking-wider uppercase">
          Canales de Comunicación Directa
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-text-main tracking-tight">
          Hablemos de Ingeniería
        </h1>
        <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-xl mx-auto">
          Sin intermediarios ni formularios ficticios. Puedes escribirme por correo, conectar por WhatsApp o coordinar vía LinkedIn.
        </p>
      </header>

      <!-- Tarjetas de Canales de Contacto Reales -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Tarjeta Correo Electrónico Principal -->
        <div class="sm:col-span-2 p-8 rounded-3xl bg-surface border border-accent/40 shadow-lg space-y-4">
          <div class="flex items-center gap-3">
            <div class="p-3 rounded-xl bg-accent text-bg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono text-success font-bold uppercase">Canal Principal</span>
              <h2 class="text-xl font-bold text-text-main">Correo Electrónico Directo</h2>
            </div>
          </div>

          <p class="text-sm text-text-muted">
            Para propuestas de arquitectura de software, consultoría en migración a microservicios, optimización Oracle SQL o plataformas tributarias.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href={`mailto:${portfolioData.contact.email}?subject=Propuesta%20de%20Proyecto%20-%20Arquitectura%20de%20Software`}
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-accent text-bg font-bold text-sm hover:bg-accent-hover transition-colors shadow-md focus-visible:outline-accent"
            >
              <span>Escribir a {portfolioData.contact.email}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <button
              id="copy-email-btn"
              type="button"
              class="px-4 py-3 rounded-xl bg-surface-hover border border-border text-text-main font-semibold text-sm hover:bg-surface transition-colors focus-visible:outline-accent inline-flex items-center gap-2"
              data-email={portfolioData.contact.email}
              aria-label="Copiar correo electrónico al portapapeles"
            >
              <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-btn-text">Copiar dirección</span>
            </button>
          </div>
        </div>

        <!-- Tarjeta WhatsApp / Teléfono Directo -->
        <a
          href="https://wa.me/51929803589?text=Hola%20Marcio,%20vi%20tu%20portafolio%20de%20arquitectura%20y%20me%20gustar%C3%ADa%20conversar."
          target="_blank"
          rel="noopener noreferrer"
          class="p-6 rounded-2xl bg-surface border border-border hover:border-success/60 transition-all shadow-sm hover:shadow-md group block focus-visible:outline-accent"
        >
          <div class="flex items-center justify-between mb-3">
            <div class="p-2.5 rounded-xl bg-surface-hover group-hover:bg-success/10 group-hover:text-success transition-colors">
              <svg class="w-6 h-6 text-success" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/>
              </svg>
            </div>
            <span class="text-xs font-mono text-success font-bold group-hover:translate-x-1 transition-transform">
              Conversar ↗
            </span>
          </div>
          <h3 class="text-lg font-bold text-text-main group-hover:text-success transition-colors">WhatsApp Directo</h3>
          <p class="text-xs text-text-muted mt-1">+51 929 803 589 · Coordinación ágil e inmediata.</p>
        </a>

        <!-- Tarjeta LinkedIn -->
        <a
          href={portfolioData.contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/60 transition-all shadow-sm hover:shadow-md group block focus-visible:outline-accent"
        >
          <div class="flex items-center justify-between mb-3">
            <div class="p-2.5 rounded-xl bg-surface-hover group-hover:bg-accent/10 group-hover:text-accent transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            </div>
            <span class="text-xs font-mono text-accent font-bold group-hover:translate-x-1 transition-transform">
              Conectar ↗
            </span>
          </div>
          <h3 class="text-lg font-bold text-text-main group-hover:text-accent transition-colors">LinkedIn</h3>
          <p class="text-xs text-text-muted mt-1">Perfil profesional, red de contactos y validación laboral.</p>
        </a>
      </div>

      <!-- Ubicación y Compromiso -->
      <div class="p-6 rounded-2xl bg-surface/40 border border-border text-center text-xs text-text-muted space-y-1">
        <p class="font-medium text-text-main">
          📍 Ubicación: {portfolioData.location} (Zona Horaria UTC-5 / Perú)
        </p>
        <p>Tiempo de respuesta habitual: Menos de 12 horas laborables.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupCopyButton() {
    const btn = document.getElementById('copy-email-btn');
    const label = document.getElementById('copy-btn-text');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email');
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        label.textContent = '¡Copiado con éxito!';
        btn.classList.add('text-success');
        setTimeout(() => {
          label.textContent = 'Copiar dirección';
          btn.classList.remove('text-success');
        }, 2500);
      } catch (e) {
        label.textContent = 'Error al copiar';
      }
    });
  }

  setupCopyButton();
</script>
