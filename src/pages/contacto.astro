---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolioData';
---

<BaseLayout
  title={`Contacto | ${portfolioData.name}`}
  description={`Canales directos de contacto profesional con ${portfolioData.name}. Correo electrónico, perfiles profesionales y disponibilidad técnica.`}
  currentPath="/contacto"
>
  <div class="py-12 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Encabezado -->
      <header class="space-y-4 text-center">
        <span class="text-xs font-mono text-accent font-semibold tracking-wider uppercase">
          Canales de Comunicación Directa
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-text-main tracking-tight">
          Hablemos de Ingeniería
        </h1>
        <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-xl mx-auto">
          Sin formularios simulados ni intermediarios. Puedes escribirme directamente a mi correo electrónico o conectar a través de mis redes profesionales oficiales.
        </p>
      </header>

      <!-- Tarjetas de Canales de Contacto Reales -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Tarjeta Correo Electrónico Principal -->
        <div class="sm:col-span-2 p-8 rounded-3xl bg-surface border border-accent/40 shadow-lg space-y-4">
          <div class="flex items-center gap-3">
            <div class="p-3 rounded-xl bg-accent text-bg">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono text-success font-bold uppercase">Canal Principal</span>
              <h2 class="text-xl font-bold text-text-main">Correo Electrónico</h2>
            </div>
          </div>

          <p class="text-sm text-text-muted">
            Para consultas de consultoría, propuestas de arquitectura de software, optimizaciones de bases de datos o integraciones tributarias.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href={`mailto:${portfolioData.contact.email}`}
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-accent text-bg font-bold text-sm hover:bg-accent-hover transition-colors shadow-md focus-visible:outline-accent"
            >
              <span>Escribir a {portfolioData.contact.email}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <button
              id="copy-email-btn"
              type="button"
              class="px-4 py-3 rounded-xl bg-surface-hover border border-border text-text-main font-semibold text-sm hover:bg-surface transition-colors focus-visible:outline-accent inline-flex items-center gap-2"
              data-email={portfolioData.contact.email}
              aria-label="Copiar correo electrónico al portapapeles"
            >
              <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-btn-text">Copiar dirección</span>
            </button>
          </div>
        </div>

        <!-- Tarjeta GitHub -->
        <a
          href={portfolioData.contact.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/60 transition-all shadow-sm hover:shadow-md group block focus-visible:outline-accent"
        >
          <div class="flex items-center justify-between mb-3">
            <div class="p-2.5 rounded-xl bg-surface-hover group-hover:bg-accent/10 group-hover:text-accent transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </div>
            <span class="text-xs font-mono text-accent font-bold group-hover:translate-x-1 transition-transform">
              Visitar ↗
            </span>
          </div>
          <h3 class="text-lg font-bold text-text-main group-hover:text-accent transition-colors">GitHub</h3>
          <p class="text-xs text-text-muted mt-1">Explora código, repositorios y contribuciones técnicas abiertas.</p>
        </a>

        <!-- Tarjeta LinkedIn -->
        <a
          href={portfolioData.contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/60 transition-all shadow-sm hover:shadow-md group block focus-visible:outline-accent"
        >
          <div class="flex items-center justify-between mb-3">
            <div class="p-2.5 rounded-xl bg-surface-hover group-hover:bg-accent/10 group-hover:text-accent transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            </div>
            <span class="text-xs font-mono text-accent font-bold group-hover:translate-x-1 transition-transform">
              Conectar ↗
            </span>
          </div>
          <h3 class="text-lg font-bold text-text-main group-hover:text-accent transition-colors">LinkedIn</h3>
          <p class="text-xs text-text-muted mt-1">Perfil profesional, red de contactos y validación de credenciales.</p>
        </a>
      </div>

      <!-- Ubicación y Compromiso -->
      <div class="p-6 rounded-2xl bg-surface/40 border border-border text-center text-xs text-text-muted space-y-1">
        <p class="font-medium text-text-main">
          📍 Ubicación: {portfolioData.location} (Zona Horaria UTC-5 / Perú)
        </p>
        <p>Tiempo de respuesta habitual: Menos de 24 horas laborables.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupCopyButton() {
    const btn = document.getElementById('copy-email-btn');
    const label = document.getElementById('copy-btn-text');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email');
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        label.textContent = '¡Copiado con éxito!';
        btn.classList.add('text-success');
        setTimeout(() => {
          label.textContent = 'Copiar dirección';
          btn.classList.remove('text-success');
        }, 2500);
      } catch (e) {
        label.textContent = 'Error al copiar';
      }
    });
  }

  setupCopyButton();
</script>

