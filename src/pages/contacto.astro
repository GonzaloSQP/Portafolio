---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolioData';

// Web3Forms (plan gratuito) solo acepta envios desde el navegador: su access_key es publica por diseno y se inyecta en build desde PUBLIC_WEB3FORMS_ACCESS_KEY (secreto Pages / .env.local, nunca en git).
const PUBLIC_CONTACT_FORM_ENDPOINT = 'https://api.web3forms.com/submit';
const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || '';
---

<BaseLayout
  title={`Contacto Directo | ${portfolioData.name}`}
  description={`Canales directos de contacto profesional con ${portfolioData.name}. Correo electrónico, formulario AJAX, WhatsApp y perfiles oficiales.`}
  currentPath="/contacto"
>
  <div class="py-10 sm:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <!-- Encabezado Recto -->
      <header class="space-y-3 text-center border-b border-border pb-6">
        <span class="text-xs font-mono text-accent font-bold tracking-wider uppercase">
          [ CANALES DE COMUNICACIÓN DIRECTA ]
        </span>
        <h1 class="text-2xl sm:text-4xl lg:text-[40px] font-black text-text-main tracking-tight leading-tight">
          Hablemos de Ingeniería
        </h1>
        <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-xl mx-auto font-sans">
          Escríbeme directo: respondo en menos de 24 horas laborables. Disponible para propuestas de arquitectura, streaming de datos masivo, optimización Oracle SQL o plataformas tributarias.
        </p>
      </header>

      <!-- Panel Dividido: Canales Directos (Izq) y Formulario Real (Der) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Columna 1: Canales Directos -->
        <div class="lg:col-span-5 space-y-4">
          <!-- Tarjeta Correo Electrónico Principal -->
          <div class="p-5 rounded-sm bg-surface border border-accent/40 shadow-sm space-y-3">
            <div class="flex items-center gap-2.5">
              <span class="p-2 rounded-sm bg-accent text-bg font-mono font-bold text-xs">@</span>
              <div>
                <span class="text-[10px] font-mono text-success font-bold uppercase tracking-wider">[ CANAL DIRECTO ]</span>
                <h2 class="text-base font-bold text-text-main">Correo Electrónico</h2>
              </div>
            </div>

            <p class="text-xs text-text-muted leading-relaxed font-sans">
              Para propuestas de arquitectura, consultoría en microservicios o integraciones tributarias:
            </p>

            <div class="pt-1 flex flex-col gap-2">
              <a
                href={`mailto:${portfolioData.contact.email}?subject=Propuesta%20de%20Proyecto%20-%20Arquitectura%20de%20Software`}
                class="px-3.5 py-2 rounded-sm bg-accent text-bg font-mono text-xs font-bold uppercase hover:bg-accent-hover transition-colors text-center shadow-sm"
              >
                Escribir a {portfolioData.contact.email}
              </a>

              <button
                id="copy-email-btn"
                type="button"
                class="px-3.5 py-1.5 rounded-sm bg-bg border border-border text-text-main font-mono text-xs font-semibold hover:border-accent/50 transition-colors inline-flex items-center justify-center gap-1.5"
                data-email={portfolioData.contact.email}
                aria-label="Copiar correo electrónico al portapapeles"
              >
                <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span id="copy-btn-text">Copiar dirección</span>
              </button>
            </div>
          </div>

          <!-- WhatsApp Directo -->
          <a
            href="https://wa.me/51929803589?text=Hola%20Marcio,%20vi%20tu%20portafolio%20de%20arquitectura%20y%20me%20gustar%C3%ADa%20conversar."
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-sm bg-surface border border-border hover:border-success/60 transition-colors shadow-sm group block focus-visible:outline-accent"
          >
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-success font-bold uppercase">[ WHATSAPP ]</span>
              <span class="text-success font-bold group-hover:translate-x-1 transition-transform">
                Conversar ↗
              </span>
            </div>
            <div class="text-sm font-bold text-text-main mt-1 group-hover:text-success transition-colors">
              +51 929 803 589
            </div>
            <p class="text-xs text-text-muted mt-0.5 font-mono">Coordinación ágil e inmediata.</p>
          </a>

          <!-- LinkedIn -->
          <a
            href={portfolioData.contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-sm bg-surface border border-border hover:border-accent/60 transition-colors shadow-sm group block focus-visible:outline-accent"
          >
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-accent font-bold uppercase">[ LINKEDIN ]</span>
              <span class="text-accent font-bold group-hover:translate-x-1 transition-transform">
                Conectar ↗
              </span>
            </div>
            <div class="text-sm font-bold text-text-main mt-1 group-hover:text-accent transition-colors">
              linkedin.com/in/marciosequeiros
            </div>
            <p class="text-xs text-text-muted mt-0.5 font-mono">Perfil profesional y validación laboral.</p>
          </a>
        </div>

        <!-- Columna 2: Formulario AJAX Real (Envíame un mensaje) -->
        <div class="lg:col-span-7 p-6 rounded-sm bg-surface border border-border shadow-sm space-y-4">
          <div class="border-b border-border pb-3">
            <span class="text-xs font-mono text-accent font-bold uppercase tracking-wider">[ MENSAJE DIRECTO ]</span>
            <h2 class="text-xl font-bold text-text-main mt-0.5">Envíame un mensaje</h2>
            <p class="text-xs text-text-muted font-sans mt-1">
              Envío directo a mi bandeja de entrada mediante transporte seguro.
            </p>
          </div>

          <form id="contact-form" class="space-y-4" data-endpoint={PUBLIC_CONTACT_FORM_ENDPOINT}>
            <!-- Honeypot anti-bots -->
            <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
            

            <div class="space-y-1">
              <label for="name" class="block text-xs font-mono font-bold text-text-main uppercase">
                Nombre Completo *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ej. Ing. Carlos Mendoza"
                class="w-full px-3 py-2 rounded-sm bg-bg border border-border text-text-main text-sm font-sans placeholder-text-dim focus:outline-none focus:border-accent transition-colors"
              />
            </div>

            <div class="space-y-1">
              <label for="email" class="block text-xs font-mono font-bold text-text-main uppercase">
                Correo Electrónico de Contacto *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="carlos@empresa.com"
                class="w-full px-3 py-2 rounded-sm bg-bg border border-border text-text-main text-sm font-sans placeholder-text-dim focus:outline-none focus:border-accent transition-colors"
              />
            </div>

            <div class="space-y-1">
              <label for="message" class="block text-xs font-mono font-bold text-text-main uppercase">
                Detalle del Proyecto o Consulta *
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Describe los requerimientos técnicos, volumen de datos o plataforma a integrar..."
                class="w-full px-3 py-2 rounded-sm bg-bg border border-border text-text-main text-sm font-sans placeholder-text-dim focus:outline-none focus:border-accent transition-colors"
              ></textarea>
            </div>

            <!-- Estado y Mensajes con aria-live -->
            <div id="form-status" aria-live="polite" class="text-xs font-mono font-bold hidden p-3 rounded-sm"></div>

            <div class="pt-2 flex flex-wrap items-center justify-between gap-3">
              <button
                type="submit"
                id="contact-submit"
                class="px-5 py-2.5 rounded-sm bg-accent text-bg font-mono text-xs font-black uppercase tracking-wider hover:bg-accent-hover transition-colors shadow-sm focus-visible:outline-accent inline-flex items-center gap-2"
              >
                <span>Enviar Mensaje</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>

              <span class="text-[11px] font-mono text-text-muted">
                Respaldo: <a href={`mailto:${portfolioData.contact.email}?subject=Consulta%20desde%20Portafolio`} class="text-accent underline">mailto directo</a>
              </span>
            </div>
          </form>
        </div>
      </div>

      <!-- Ubicación y Compromiso -->
      <div class="p-4 rounded-sm bg-surface border border-border text-center text-xs font-mono text-text-muted space-y-1">
        <p class="font-bold text-text-main">
          📍 Ubicación: {portfolioData.location} (Zona Horaria UTC-5 / Perú)
        </p>
        <p>Tiempo de respuesta garantizado: Menos de 24 horas laborables.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ web3formsAccessKey }}>
  function setupContactForm() {
    const form = document.getElementById('contact-form');
    const statusBox = document.getElementById('form-status');
    const submitBtn = document.getElementById('contact-submit');
    if (!form || !statusBox || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const endpoint = form.getAttribute('data-endpoint') || 'https://api.web3forms.com/submit';
      const formData = new FormData(form);

      // Verificación honeypot
      if (formData.get('_honey')) return;

      if (!web3formsAccessKey) { statusBox.className = 'text-xs font-mono font-bold p-3 rounded-sm bg-error/15 text-error border border-error/30'; statusBox.textContent = 'Formulario no configurado. Por favor escribeme directamente a chalot_6@hotmail.com'; return; }
      // URLSearchParams = petición simple (sin preflight OPTIONS, que Web3Forms rechaza con 403)
      const payload = new URLSearchParams({
        access_key: web3formsAccessKey,
        subject: '[Portafolio] Mensaje de ' + String(formData.get('name') || 'visitante'),
        name: String(formData.get('name') || ''),
        email: String(formData.get('email') || ''),
        message: String(formData.get('message') || ''),
        botcheck: '',
      });
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
      statusBox.classList.remove('hidden', 'bg-error/15', 'text-error', 'border-error/30', 'bg-success/15', 'text-success', 'border-success/30');
      statusBox.classList.add('bg-accent-bg', 'text-accent', 'border', 'border-accent/30');
      statusBox.textContent = 'Procesando envío directo...';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: payload,
          headers: { 'Accept': 'application/json' }
        });

        const payload = await response.json().catch(() => null);
        if (response.ok && payload && payload.success) {
          statusBox.className = 'text-xs font-mono font-bold p-3 rounded-sm bg-success/15 text-success border border-success/30';
          statusBox.textContent = '✓ Mensaje recibido correctamente. Me pondré en contacto en menos de 24 horas.';
          form.reset();
        } else {
          throw new Error('Respuesta no satisfactoria del servidor');
        }
      } catch (error) {
        statusBox.className = 'text-xs font-mono font-bold p-3 rounded-sm bg-error/15 text-error border border-error/30';
        statusBox.textContent = '✕ No se pudo enviar por AJAX. Por favor escríbeme directamente a chalot_6@hotmail.com';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar Mensaje';
      }
    });
  }

  function setupCopyButton() {
    const btn = document.getElementById('copy-email-btn');
    const label = document.getElementById('copy-btn-text');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email');
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        label.textContent = '¡Copiado!';
        btn.classList.add('text-success');
        setTimeout(() => {
          label.textContent = 'Copiar dirección';
          btn.classList.remove('text-success');
        }, 2500);
      } catch (e) {
        label.textContent = 'Error al copiar';
      }
    });
  }

  setupContactForm();
  setupCopyButton();
</script>
