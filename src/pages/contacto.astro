---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolioData';
import { CAL_LINK, WHATSAPP_NUMBER } from '../data/services';
---

<BaseLayout title={`Contacto | ${portfolioData.name}`} description="WhatsApp, agenda o correo. Tres vías, sin formulario largo." currentPath="/contacto">
  <div class="py-10 sm:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <header class="space-y-3 text-center border-b border-border pb-6">
        <span class="text-xs font-mono text-accent font-bold tracking-wider uppercase">[ TRES VÍAS, SIN FORMULARIO LARGO ]</span>
        <h1 class="text-2xl sm:text-4xl font-black text-text-main tracking-tight">Cuéntame tu problema</h1>
        <p class="text-sm text-text-muted max-w-xl mx-auto">Te respondo en menos de 24 horas laborables con si puedo resolverlo, qué entregaría y en cuánto tiempo.</p>
      </header>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola Marcio, te cuento mi problema:')}`} target="_blank" rel="noopener noreferrer" class="p-5 rounded-sm bg-surface border-2 border-success/50 space-y-2 block focus-visible:outline-accent">
          <span class="text-xs font-mono font-bold text-success uppercase">1 · WhatsApp (recomendado)</span>
          <h2 class="text-base font-bold text-text-main">+51 929 803 589</h2>
          <p class="text-xs text-text-muted">Respuesta más rápida. Cuéntame qué sistema tienes y qué falla.</p>
          <span class="text-xs font-mono font-bold text-success uppercase">Escribir ahora →</span>
        </a>
        <div class="p-5 rounded-sm bg-surface border border-border space-y-2">
          <span class="text-xs font-mono font-bold text-accent uppercase">2 · Agenda</span>
          <h2 class="text-base font-bold text-text-main">Reserva una llamada</h2>
          <p class="text-xs text-text-muted">Por WhatsApp coordinamos el horario que te convenga (UTC-5, Perú).</p>
          <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola Marcio, quiero agendar una llamada. Mi disponibilidad es:')}`} target="_blank" rel="noopener noreferrer" class="text-xs font-mono font-bold text-accent uppercase">Coordinar horario →</a>
        </div>
        <div class="p-5 rounded-sm bg-surface border border-border space-y-2">
          <span class="text-xs font-mono font-bold text-accent uppercase">3 · Correo</span>
          <h2 class="text-base font-bold text-text-main">{portfolioData.contact.email}</h2>
          <p class="text-xs text-text-muted">Para propuestas formales o con adjuntos.</p>
          <!--email_off-->
          <a href={`mailto:${portfolioData.contact.email}?subject=Mi%20problema%20(te%20cuento)`} class="text-xs font-mono font-bold text-accent uppercase">Escribir correo →</a>
          <!--/email_off-->
        </div>
      </div>
      <div class="p-4 rounded-sm bg-surface border border-border text-xs font-mono text-text-muted text-center space-y-1">
        <p>LinkedIn: <a class="text-accent hover:underline" href={portfolioData.contact.linkedin} target="_blank" rel="noopener noreferrer">{portfolioData.contact.linkedin}</a></p>
        <p>Ubicación: {portfolioData.location} · UTC-5</p>
      </div>
    </div>
  </div>
</BaseLayout>
