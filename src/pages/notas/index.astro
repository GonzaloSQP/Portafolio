---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { portfolioData } from '../../data/portfolioData';

const articles = [
  {
    slug: 'streaming-reactivo-oracle-jakarta',
    title: 'Streaming reactivo con Oracle SQL y Jakarta EE: Cómo procesar 1M de registros sin agotar el Heap',
    description: 'Análisis detallado de la migración de un reporteador bancario: optimización de cursores JDBC, sintonización de FetchSize y procesamiento reactivo por chunks concurrentes.',
    date: 'Noviembre 2025',
    readTime: '6 min de lectura',
    tags: ['Jakarta EE', 'Oracle SQL', 'Reactive Streams', 'Heap Tuning', 'Banca'],
    impact: 'De 4h 15m a 14m 20s · 90% menos consumo de memoria JVM'
  },
  {
    slug: 'pre-auditoria-ubl-sunat',
    title: 'Arquitectura de pre-auditoría UBL 2.1: Reducción del 95% de rechazos fiscales antes de la firma digital',
    description: 'Estrategia de validación en memoria para comprobantes electrónicos SUNAT, aislamiento de firmas X.509 y desacoplamiento con colas Redis para más de 30 empresas.',
    date: 'Octubre 2025',
    readTime: '5 min de lectura',
    tags: ['UBL 2.1', 'SUNAT API', 'Microservicios', 'Redis', 'Seguridad X.509'],
    impact: 'Tasa de rechazo reducida de 24.8% a <1.2% en producción'
  }
];
---

<BaseLayout
  title={`Notas de Ingeniería & Arquitectura | ${portfolioData.name}`}
  description="Artículos técnicos y notas de ingeniería sobre streaming reactivo, optimización de consultas Oracle masivas y plataformas de facturación electrónica de alta disponibilidad."
  currentPath="/notas"
>
  <div class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Encabezado -->
      <header class="space-y-4">
        <span class="text-xs font-mono text-accent font-semibold tracking-wider uppercase">
          Artículos Técnicos & Casos de Arquitectura
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-text-main tracking-tight">
          Notas de Ingeniería
        </h1>
        <p class="text-base sm:text-lg text-text-muted leading-relaxed">
          Reflexiones de diseño, benchmarks y soluciones técnicas aplicadas en sistemas de producción reales.
        </p>
      </header>

      <!-- Lista de Artículos -->
      <div class="space-y-8">
        {articles.map((art) => (
          <article class="p-6 sm:p-8 rounded-2xl bg-surface border border-border hover:border-accent/50 transition-all duration-200 group">
            <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-text-muted mb-3">
              <span class="text-accent font-semibold">{art.date} · {art.readTime}</span>
              <span class="px-2.5 py-0.5 rounded-full bg-success/10 text-success border border-success/20 font-bold">
                {art.impact}
              </span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-text-main group-hover:text-accent transition-colors tracking-tight">
              <a href={`/notas/${art.slug}`} class="focus-visible:outline-accent">
                {art.title}
              </a>
            </h2>

            <p class="mt-3 text-sm sm:text-base text-text-muted leading-relaxed">
              {art.description}
            </p>

            <div class="mt-6 pt-4 border-t border-border flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap gap-1.5">
                {art.tags.map((tag) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-surface-hover border border-border text-text-muted">
                    {tag}
                  </span>
                ))}
              </div>

              <a
                href={`/notas/${art.slug}`}
                class="inline-flex items-center gap-1 text-xs font-bold text-accent group-hover:translate-x-1 transition-transform"
              >
                <span>Leer artículo completo</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
