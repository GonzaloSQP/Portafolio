---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolioData';

const pmiCert = portfolioData.certifications[0];
---

<BaseLayout
  title={`Sobre Mí | ${portfolioData.name}`}
  description={`Perfil profesional, trayectoria y formación técnica de ${portfolioData.name}, ${portfolioData.title}.`}
  currentPath="/sobre-mi"
>
  <div class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- Encabezado de Perfil con Foto/Avatar Profesional y Acciones de Conversión -->
      <header class="p-8 sm:p-10 rounded-3xl bg-surface border border-border shadow-md space-y-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8">
          <!-- Avatar Profesional Estilizado -->
          <div class="relative shrink-0">
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-gradient-to-br from-accent to-blue-700 flex items-center justify-center text-bg text-3xl font-black font-mono shadow-xl border-2 border-accent/40">
              MS
            </div>
            <span class="absolute -bottom-1.5 -right-1.5 w-6 h-6 rounded-full bg-success border-2 border-surface flex items-center justify-center text-[10px] text-bg font-bold" title="Disponible para proyectos">
              ✓
            </span>
          </div>

          <!-- Información Principal -->
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-mono text-accent font-semibold px-2.5 py-0.5 rounded-full bg-accent/10 border border-accent/20">
                {portfolioData.location} ({portfolioData.age} años)
              </span>
              <span class="text-xs font-mono text-success font-semibold px-2.5 py-0.5 rounded-full bg-success/10 border border-success/20">
                Full-Time / Consultorías
              </span>
            </div>

            <h1 class="text-2xl sm:text-4xl font-black text-text-main tracking-tight">
              {portfolioData.name}
            </h1>

            <p class="text-base sm:text-lg font-semibold text-accent">
              {portfolioData.title}
            </p>
          </div>
        </div>

        <p class="text-sm sm:text-base text-text-muted leading-relaxed">
          {portfolioData.summary}
        </p>

        <!-- Botones de Conversión: Descargar CV y Contacto Directo -->
        <div class="pt-2 flex flex-wrap items-center gap-3 border-t border-border/80">
          <a
            href="/contacto"
            class="px-5 py-2.5 rounded-xl bg-accent text-bg font-bold text-sm hover:bg-accent-hover transition-colors shadow-sm focus-visible:outline-accent inline-flex items-center gap-2"
          >
            <span>Contactar Directamente</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="javascript:window.print()"
            class="px-5 py-2.5 rounded-xl bg-surface-hover border border-border text-text-main font-semibold text-sm hover:bg-surface transition-colors focus-visible:outline-accent inline-flex items-center gap-2"
            title="Imprimir o guardar CV en PDF"
          >
            <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Descargar CV (PDF)</span>
          </a>

          <a
            href={portfolioData.contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-xl border border-border text-text-muted hover:text-text-main hover:bg-surface text-sm font-medium transition-colors inline-flex items-center gap-1.5"
          >
            <span>LinkedIn</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </header>

      <!-- Experiencia Laboral en Sistemas de Producción (COOPAC Los Andes + Soluciones Software SAC) -->
      <section class="space-y-8" aria-labelledby="experience-title">
        <div>
          <span class="text-xs font-mono text-accent font-semibold tracking-wider uppercase">
            Trayectoria Técnica
          </span>
          <h2 id="experience-title" class="text-2xl sm:text-3xl font-black text-text-main tracking-tight mt-1">
            Experiencia en Sistemas de Producción
          </h2>
        </div>

        <div class="space-y-8 relative before:absolute before:inset-0 before:left-4 before:w-0.5 before:bg-border">
          {portfolioData.experience.map((exp) => (
            <div class="relative pl-10 sm:pl-12 space-y-3">
              <!-- Punto de la línea de tiempo -->
              <span class="absolute left-2.5 top-1.5 -translate-x-1/2 w-3.5 h-3.5 rounded-full border-2 border-accent bg-bg"></span>

              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-xl font-bold text-text-main">
                  {exp.role}
                </h3>
                <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-surface border border-border text-text-muted">
                  {exp.period}
                </span>
              </div>

              <p class="text-sm font-semibold text-accent">
                {exp.company} · {exp.location}
              </p>

              <ul class="space-y-2 text-sm text-text-muted leading-relaxed pt-2">
                {exp.highlights.map((h) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-accent font-bold mt-0.5">›</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-3 flex flex-wrap gap-1.5">
                {exp.technologies.map((t) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-surface border border-border text-text-muted">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Formación Académica (Universidad Continental & UNSAAC) -->
      {portfolioData.education && (
        <section class="space-y-6" aria-labelledby="education-title">
          <div>
            <span class="text-xs font-mono text-accent font-semibold tracking-wider uppercase">
              Formación Académica
            </span>
            <h2 id="education-title" class="text-2xl sm:text-3xl font-black text-text-main tracking-tight mt-1">
              Educación Universitaria & Técnica
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {portfolioData.education.map((edu) => (
              <div class="p-6 rounded-2xl bg-surface border border-border space-y-2 shadow-sm">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono text-accent font-bold">{edu.period}</span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-text-main">
                  {edu.degree}
                </h3>
                <p class="text-sm font-semibold text-text-muted">
                  {edu.institution}
                </p>
                {edu.detail && (
                  <p class="text-xs text-text-muted pt-1 leading-relaxed">
                    {edu.detail}
                  </p>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Certificaciones y Metodología (Ubicación Discreta y Proporcional) -->
      <section class="p-6 rounded-2xl bg-surface/60 border border-border space-y-3" aria-labelledby="certifications-title">
        <h3 id="certifications-title" class="text-sm font-mono font-bold text-text-main uppercase tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Certificaciones de Metodología y Gestión
        </h3>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <div class="space-y-0.5">
            <span class="font-bold text-text-main">{pmiCert.name}</span>
            <span class="text-text-muted"> · {pmiCert.issuer} (Expedición: {pmiCert.issueDate})</span>
          </div>
          <div class="flex items-center gap-2 font-mono">
            <span class="text-text-muted">Licencia: <strong>{pmiCert.credentialId}</strong></span>
            <a
              href={pmiCert.verificationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:underline ml-2"
            >
              Verificar en Certiport ↗
            </a>
          </div>
        </div>
      </section>

      <!-- Principios de Arquitectura e Ingeniería -->
      <section class="p-8 rounded-3xl bg-surface/50 border border-border space-y-6" aria-labelledby="principles-title">
        <h2 id="principles-title" class="text-xl sm:text-2xl font-bold text-text-main tracking-tight">
          Principios Rectores de Ingeniería
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
          <div class="space-y-2">
            <h3 class="font-bold text-text-main flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              Streaming sobre Cargas en Memoria
            </h3>
            <p class="text-text-muted leading-relaxed">
              Evitar desbordes de Heap y bloqueos transaccionales en bases de datos mediante cursores continuos y transacciones atómicas por chunks.
            </p>
          </div>

          <div class="space-y-2">
            <h3 class="font-bold text-text-main flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              Resiliencia Fiscal y Pre-Auditoría UBL 2.1
            </h3>
            <p class="text-text-muted leading-relaxed">
              En facturación electrónica y servicios SUNAT, la validación en memoria previa a la firma digital previene fallos y multas tributarias.
            </p>
          </div>

          <div class="space-y-2">
            <h3 class="font-bold text-text-main flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              Caché Estratégico y Baja Latencia
            </h3>
            <p class="text-text-muted leading-relaxed">
              Microservicios con contratos REST limpios y persistencia en memoria con Redis para absorber picos de tráfico sub-100ms.
            </p>
          </div>

          <div class="space-y-2">
            <h3 class="font-bold text-text-main flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              Simplicidad Operativa
            </h3>
            <p class="text-text-muted leading-relaxed">
              Cero abstracciones innecesarias. Arquitecturas medibles, testeables y fáciles de operar en entornos productivos.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
