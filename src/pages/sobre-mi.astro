---
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolioData';

const pmiCert = portfolioData.certifications[0];
---

<BaseLayout
  title={`Sobre Mí | ${portfolioData.name}`}
  description={`Perfil profesional, trayectoria y formación técnica de ${portfolioData.name}, ${portfolioData.title}.`}
  currentPath="/sobre-mi"
>
  <div class="py-10 sm:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Encabezado de Perfil Recto y Refinado -->
      <header class="p-6 sm:p-8 rounded-sm bg-surface border border-border shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-6">
          <!-- Avatar Profesional Rectangular -->
          <div class="relative shrink-0">
            <div class="w-20 h-20 rounded-sm bg-accent text-bg flex items-center justify-center text-2xl font-black font-mono border border-accent/40 shadow-sm">
              MS
            </div>
            <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-none bg-success text-bg flex items-center justify-center text-[10px] font-bold" title="Disponible para proyectos">
              ✓
            </span>
          </div>

          <!-- Información Principal -->
          <div class="space-y-1.5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-mono font-bold text-accent px-2 py-0.5 rounded-sm bg-accent-bg border border-accent/30 uppercase">
                {portfolioData.location}
              </span>
              <span class="text-xs font-mono font-bold text-success px-2 py-0.5 rounded-sm bg-success/10 border border-success/30 uppercase">
                FULL-TIME / CONSULTORÍAS
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-text-main tracking-tight">
              {portfolioData.name}
            </h1>

            <p class="text-sm sm:text-base font-bold text-accent font-mono uppercase tracking-wide">
              {portfolioData.title}
            </p>
          </div>
        </div>

        <p class="text-sm sm:text-base text-text-muted leading-relaxed font-sans border-t border-border pt-4">
          {portfolioData.summary}
        </p>

        <!-- Botones de Conversión Rectos -->
        <div class="pt-2 flex flex-wrap items-center gap-2.5 border-t border-border/80">
          <a
            href="/contacto"
            class="px-5 py-2.5 rounded-sm bg-accent text-bg font-mono text-xs font-black uppercase tracking-wider hover:bg-accent-hover transition-colors shadow-sm focus-visible:outline-accent inline-flex items-center gap-2"
          >
            <span>Contactar Directamente</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="/cv"
            class="px-5 py-2.5 rounded-sm bg-bg border border-border text-text-main font-mono text-xs font-bold uppercase tracking-wider hover:bg-surface-hover hover:border-accent/40 transition-colors focus-visible:outline-accent inline-flex items-center gap-2"
            title="Ver o guardar CV en formato PDF"
          >
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Ver Currículum (PDF)</span>
          </a>

          <a
            href={portfolioData.contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-sm border border-border text-text-muted hover:text-text-main hover:bg-surface text-xs font-mono font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1.5"
          >
            <span>LinkedIn ↗</span>
          </a>
        </div>
      </header>

      <!-- Experiencia Laboral en Sistemas de Producción -->
      <section class="space-y-6" aria-labelledby="experience-title">
        <div class="border-b border-border pb-3">
          <span class="text-xs font-mono text-accent font-bold tracking-wider uppercase">
            [ TRAYECTORIA PROFESIONAL EN PRODUCCIÓN ]
          </span>
          <h2 id="experience-title" class="text-xl sm:text-2xl font-black text-text-main tracking-tight mt-1">
            Experiencia en Sistemas de Alta Disponibilidad
          </h2>
        </div>

        <div class="space-y-6 relative before:absolute before:inset-0 before:left-3 before:w-0.5 before:bg-border">
          {portfolioData.experience.map((exp) => (
            <div class="relative pl-8 sm:pl-10 space-y-2.5">
              <!-- Punto de la línea de tiempo recto -->
              <span class="absolute left-1.5 top-2 -translate-x-1/2 w-3 h-3 rounded-none border-2 border-accent bg-bg"></span>

              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h3 class="text-lg font-bold text-text-main">
                  {exp.role}
                </h3>
                <span class="text-xs font-mono px-2 py-0.5 rounded-sm bg-surface border border-border text-text-muted">
                  {exp.period}
                </span>
              </div>

              <p class="text-xs font-mono font-bold text-accent uppercase">
                {exp.company} · {exp.location}
              </p>

              <ul class="space-y-1.5 text-sm text-text-muted leading-relaxed pt-1 font-sans">
                {exp.highlights.map((h) => (
                  <li class="flex items-start gap-2">
                    <span class="text-accent font-bold mt-0.5">›</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-2 flex flex-wrap gap-1">
                {exp.technologies.map((t) => (
                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded-sm bg-surface border border-border text-text-muted">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Formación Académica -->
      {portfolioData.education && (
        <section class="space-y-4" aria-labelledby="education-title">
          <div class="border-b border-border pb-3">
            <span class="text-xs font-mono text-accent font-bold tracking-wider uppercase">
              [ FORMACIÓN ACADÉMICA & UNIVERSITARIA ]
            </span>
            <h2 id="education-title" class="text-xl sm:text-2xl font-black text-text-main tracking-tight mt-1">
              Educación en Sistemas e Informática
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {portfolioData.education.map((edu) => (
              <div class="p-5 rounded-sm bg-surface border border-border space-y-1.5 shadow-sm">
                <div class="flex items-center justify-between text-xs font-mono text-accent font-bold uppercase">
                  <span>{edu.period}</span>
                </div>
                <h3 class="text-base font-bold text-text-main">
                  {edu.degree}
                </h3>
                <p class="text-xs font-mono font-semibold text-text-muted">
                  {edu.institution}
                </p>
                {edu.detail && (
                  <p class="text-xs text-text-muted pt-1 leading-relaxed font-sans">
                    {edu.detail}
                  </p>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Certificaciones (Ubicación Discreta y Proporcional) -->
      <section class="p-4 sm:p-5 rounded-sm bg-surface border border-border space-y-2" aria-labelledby="certifications-title">
        <h3 id="certifications-title" class="text-xs font-mono font-bold text-text-main uppercase tracking-wider flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-accent"></span>
          Certificación de Metodología y Gestión:
        </h3>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
          <div class="space-y-0.5">
            <span class="font-bold text-text-main">{pmiCert.name}</span>
            <span class="text-text-muted"> · {pmiCert.issuer} ({pmiCert.issueDate})</span>
          </div>
          <div class="flex items-center gap-2 font-mono">
            <span class="text-text-muted">Licencia: <strong>{pmiCert.credentialId}</strong></span>
            <a
              href={pmiCert.verificationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:underline ml-1"
            >
              Verificar en Certiport ↗
            </a>
          </div>
        </div>
      </section>

      <!-- Principios de Arquitectura e Ingeniería -->
      <section class="p-6 sm:p-7 rounded-sm bg-surface border border-border space-y-5" aria-labelledby="principles-title">
        <div class="border-b border-border pb-3">
          <span class="text-xs font-mono text-accent font-bold tracking-wider uppercase">
            [ CRITERIOS DE DISEÑO & DISCIPLINA TÉCNICA ]
          </span>
          <h2 id="principles-title" class="text-xl font-bold text-text-main tracking-tight mt-1">
            Principios Rectores de Ingeniería
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
          <div class="space-y-1.5">
            <h3 class="font-bold text-text-main flex items-center gap-2 text-sm font-mono uppercase">
              <span class="w-1.5 h-1.5 bg-accent"></span>
              Streaming sobre Cargas en Memoria
            </h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-sans">
              Evitar desbordes de Heap y bloqueos transaccionales en bases de datos mediante cursores continuos y transacciones atómicas por chunks.
            </p>
          </div>

          <div class="space-y-1.5">
            <h3 class="font-bold text-text-main flex items-center gap-2 text-sm font-mono uppercase">
              <span class="w-1.5 h-1.5 bg-accent"></span>
              Resiliencia Fiscal y Pre-Auditoría UBL 2.1
            </h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-sans">
              En facturación electrónica y servicios SUNAT, la validación en memoria previa a la firma digital previene fallos y multas tributarias.
            </p>
          </div>

          <div class="space-y-1.5">
            <h3 class="font-bold text-text-main flex items-center gap-2 text-sm font-mono uppercase">
              <span class="w-1.5 h-1.5 bg-accent"></span>
              Caché Estratégico y Baja Latencia
            </h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-sans">
              Microservicios con contratos REST limpios y persistencia en memoria con Redis para absorber picos de tráfico sub-100ms.
            </p>
          </div>

          <div class="space-y-1.5">
            <h3 class="font-bold text-text-main flex items-center gap-2 text-sm font-mono uppercase">
              <span class="w-1.5 h-1.5 bg-accent"></span>
              Simplicidad Operativa
            </h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-sans">
              Cero abstracciones innecesarias. Arquitecturas medibles, testeables y fáciles de operar en entornos productivos.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
