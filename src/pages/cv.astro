---
import { portfolioData } from '../data/portfolioData';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Curriculum Vitae | {portfolioData.name}</title>
  <meta name="description" content={`Currículum Vitae profesional de ${portfolioData.name}, ${portfolioData.title}.`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    @page {
      size: A4;
      margin: 1.2cm 1.4cm;
    }
    @media print {
      body {
        background: #ffffff !important;
        color: #0f172a !important;
        font-size: 10pt;
      }
      .no-print {
        display: none !important;
      }
      .page-break {
        page-break-before: always;
      }
      .print-shadow-none {
        box-shadow: none !important;
        border: none !important;
      }
      a {
        text-decoration: none !important;
        color: inherit !important;
      }
    }
    /* Estilos de contingencia por si se renderiza antes del paquete CSS */
    .cv-icon {
      width: 16px !important;
      height: 16px !important;
      min-width: 16px !important;
      max-width: 16px !important;
      max-height: 16px !important;
      display: inline-block !important;
      vertical-align: middle !important;
    }
    .cv-container {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
  </style>
  <script is:inline>
    // Soporte para impresión automática si se llama con ?print=true
    if (new URLSearchParams(window.location.search).get('print') === 'true') {
      window.addEventListener('DOMContentLoaded', () => window.print());
    }
  </script>
</head>
<body class="cv-container bg-slate-900 text-slate-100 min-h-full p-3 sm:p-8 antialiased selection:bg-cyan-500 selection:text-slate-900">
  <!-- Barra Superior de Control (Solo pantalla) -->
  <aside class="no-print max-w-4xl mx-auto mb-6 flex flex-wrap items-center justify-between gap-3 p-3.5 bg-slate-800 rounded-sm shadow-md border border-slate-700" aria-label="Controles de documento">
    <a
      href="/sobre-mi"
      class="text-xs font-mono font-bold text-cyan-400 uppercase hover:underline inline-flex items-center gap-1.5 focus:outline-none focus:ring-1 focus:ring-cyan-400"
    >
      <svg class="cv-icon" style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>Volver al portafolio</span>
    </a>
    <div class="flex items-center gap-2.5">
      <button
        type="button"
        id="copy-cv-link"
        class="px-3.5 py-2 rounded-sm bg-slate-700 hover:bg-slate-600 text-slate-200 font-mono font-bold text-xs uppercase tracking-wider transition-colors inline-flex items-center gap-1.5 border border-slate-600 focus:outline-none focus:ring-1 focus:ring-cyan-400"
      >
        <svg class="cv-icon" style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <span id="copy-cv-text">Copiar enlace</span>
      </button>

      <button
        type="button"
        onclick="window.print()"
        class="px-4 py-2 rounded-sm bg-cyan-600 hover:bg-cyan-500 text-slate-950 font-mono font-black text-xs uppercase tracking-wider transition-colors inline-flex items-center gap-2 shadow-sm focus:outline-none focus:ring-1 focus:ring-cyan-300"
      >
        <svg class="cv-icon" style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        <span>Guardar como PDF / Imprimir</span>
      </button>
    </div>
  </aside>

  <!-- Hoja de Currículum en Papel Blanco para Lectura Óptima e Impresión Fiel -->
  <main class="max-w-4xl mx-auto bg-white text-slate-900 p-6 sm:p-12 rounded-sm shadow-xl border border-slate-300 print-shadow-none space-y-6">
    <!-- Encabezado del CV -->
    <header class="border-b-2 border-slate-900 pb-5 flex flex-col sm:flex-row justify-between items-start gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
          {portfolioData.name}
        </h1>
        <p class="text-base sm:text-lg font-bold text-cyan-800 mt-0.5">
          {portfolioData.title}
        </p>
        <p class="text-xs text-slate-600 mt-1 font-mono">
          {portfolioData.location} · Disponibilidad Inmediata
        </p>
      </div>

      <div class="text-xs text-slate-700 font-mono space-y-1 sm:text-right shrink-0">
        <div>Email: <!--email_off--><a href={`mailto:${portfolioData.contact.email}`} class="text-cyan-800 font-bold hover:underline">{portfolioData.contact.email}</a><!--/email_off--></div>
        <div>Móvil: <a href={`https://wa.me/51929803589`} class="text-slate-900 font-semibold">{portfolioData.contact.phone}</a></div>
        <div>LinkedIn: <a href={portfolioData.contact.linkedin} class="text-cyan-800 hover:underline">linkedin.com/in/marciosequeiros</a></div>
        <div>Portafolio & Código: <a href="https://dev.apiscusco.com" class="text-cyan-800 font-semibold hover:underline">dev.apiscusco.com</a></div>
      </div>
    </header>

    <!-- Resumen Profesional -->
    <section class="space-y-2">
      <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-950 border-b border-slate-300 pb-1">
        Perfil Profesional
      </h2>
      <p class="text-xs sm:text-sm text-slate-700 leading-relaxed text-justify">
        {portfolioData.summary}
      </p>
    </section>

    <!-- Especialidades Técnicas Core -->
    <section class="space-y-2">
      <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-950 border-b border-slate-300 pb-1">
        Competencias Técnicas y Arquitectura
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-800 leading-relaxed">
        <div><strong>Lenguajes & Backend:</strong> Go 1.26, Java / Jakarta EE, Python 3.12 (FastAPI), C# / .NET 8, Node.js / TypeScript.</div>
        <div><strong>Bases de Datos & Streaming:</strong> Oracle SQL (Tuning & Tracing), PostgreSQL 16 (pgvector), Redis 7, Reactive Streams.</div>
        <div><strong>Normativa Fiscal & Seguridad:</strong> Facturación SUNAT UBL 2.1, Firmas digitales X.509, Schemas XSD, CDRs, memfd_create.</div>
        <div><strong>Arquitectura & DevOps:</strong> Clean Architecture, SOLID, Microservicios, Docker, ClickOnce automatizado, Cloudflare Edge.</div>
      </div>
    </section>

    <!-- Experiencia Laboral -->
    <section class="space-y-5">
      <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-950 border-b border-slate-300 pb-1">
        Experiencia Profesional
      </h2>

      {portfolioData.experience.map((exp) => (
        <div class="space-y-1.5">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <div>
              <span class="text-sm font-bold text-slate-950">{exp.role}</span>
              <span class="text-xs font-semibold text-cyan-800 sm:ml-2">· {exp.company}</span>
            </div>
            <span class="text-xs font-mono text-slate-600">{exp.period} | {exp.location}</span>
          </div>

          <ul class="list-disc list-outside ml-4 space-y-1 text-xs text-slate-700 leading-relaxed">
            {exp.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <!-- Casos de Impacto y Logros Técnicos Verificables -->
    <section class="space-y-3">
      <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-950 border-b border-slate-300 pb-1">
        Casos de Estudio Técnicos & Métricas Clave
      </h2>

      <div class="space-y-2.5 text-xs text-slate-800">
        <div class="p-3 bg-slate-50 rounded-sm border border-slate-200">
          <div class="font-bold text-slate-950">Migración de Reporteador Bancario & Streaming de Datos (COOPAC Los Andes):</div>
          <p class="mt-0.5 text-slate-700">
            Modernización de monolito Visual Basic a microservicios Jakarta EE. Se eliminaron bloqueos por consultas Oracle SQL no indexadas de +300 líneas, logrando procesar <strong>más de 1,000,000 de registros en 14m 20s</strong> (reducción del 94.4% frente a la línea base de > 4 horas) manteniendo la memoria Heap JVM acotada en 380 MB estables mediante cursores JDBC con FetchSize de 2,500.
          </p>
        </div>

        <div class="p-3 bg-slate-50 rounded-sm border border-slate-200">
          <div class="font-bold text-slate-950">Centralizador de Comprobantes Electrónicos & Pre-Auditoría SUNAT (Soluciones de Software SAC):</div>
          <p class="mt-0.5 text-slate-700">
            WorkerServer en .NET 8 con pre-auditoría en memoria contra esquemas XSD y catálogos UBL 2.1 oficiales previo a la firma digital X.509 para más de 30 empresas corporativas. <strong>Reducción comprobada del 95.2% en rechazos SUNAT</strong> (tasa de error reducida de 24.8% a &lt; 1.2% auditado en producción).
          </p>
        </div>

        <div class="p-3 bg-slate-50 rounded-sm border border-slate-200">
          <div class="font-bold text-slate-950">Suite SaaS de APIs de Consulta & Failover (apis.apiscusco.com):</div>
          <p class="mt-0.5 text-slate-700">
            Motor de conmutación por error en cadena (7+ proveedores) y Circuit Breakers en TypeScript/Node.js con almacenamiento en caché Redis, alcanzando <strong>latencia media de 95 ms</strong> y 99.8% de disponibilidad ante caídas upstream.
          </p>
        </div>
      </div>
    </section>

    <!-- Formación y Educación -->
    <section class="space-y-3">
      <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-950 border-b border-slate-300 pb-1">
        Formación Académica
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-800">
        {portfolioData.education?.map((edu) => (
          <div>
            <div class="font-bold text-slate-950">{edu.degree}</div>
            <div class="text-cyan-800 font-semibold">{edu.institution}</div>
            <div class="text-slate-600 font-mono text-[11px]">{edu.period}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Certificación Discreta -->
    <section class="border-t border-slate-200 pt-3 flex flex-col sm:flex-row justify-between text-xs text-slate-600">
      <div>
        <strong>Acreditación Metodológica:</strong> {portfolioData.certifications[0].name} ({portfolioData.certifications[0].issuer})
      </div>
      <div class="font-mono text-[11px]">
        Licencia: {portfolioData.certifications[0].credentialId} (verify.certiport.com)
      </div>
    </section>
  </main>

  <script is:inline>
    const copyBtn = document.getElementById('copy-cv-link');
    const copyText = document.getElementById('copy-cv-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyText.textContent = '¡Copiado!';
          setTimeout(() => {
            copyText.textContent = 'Copiar enlace';
          }, 2000);
        } catch {
          copyText.textContent = 'Error al copiar';
        }
      });
    }
  </script>
</body>
</html>
