---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MetricsStrip from '../components/MetricsStrip.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { portfolioData } from '../data/portfolioData';

const featuredProjects = portfolioData.projects.filter((p) => p.featured);
const pmiCert = portfolioData.certifications[0];
---

<BaseLayout currentPath="/">
  <!-- Sección Hero Principal -->
  <Hero />

  <!-- Banda de Métricas Clave -->
  <MetricsStrip />

  <!-- Sección de Proyectos Destacados -->
  <section id="proyectos" class="py-16 sm:py-24" aria-labelledby="featured-projects-title">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-mono text-accent font-semibold tracking-wider uppercase">
            Casos de Estudio & Arquitectura
          </span>
          <h2 id="featured-projects-title" class="text-2xl sm:text-4xl font-black text-text-main tracking-tight mt-1">
            Proyectos de Misión Crítica
          </h2>
        </div>
        <a
          href="/proyectos"
          class="inline-flex items-center text-sm font-semibold text-accent hover:text-accent-hover transition-colors"
        >
          Ver todos los proyectos ({portfolioData.projects.length})
          <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Grid de Proyectos -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
        {featuredProjects.map((project, idx) => (
          <ProjectCard project={project} featured={idx === 0} />
        ))}
      </div>
    </div>
  </section>

  <!-- Sección de Experiencia y Certificación PMI -->
  <section class="py-16 border-t border-border bg-surface/20" aria-labelledby="credentials-title">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-4">
          <span class="text-xs font-mono text-accent font-semibold uppercase">
            Rigor Metodológico & Gestión
          </span>
          <h2 id="credentials-title" class="text-2xl sm:text-3xl font-black text-text-main tracking-tight">
            Ingeniería de software respaldada por gestión certificada
          </h2>
          <p class="text-sm sm:text-base text-text-muted leading-relaxed">
            La construcción de sistemas distribuidos y plataformas fiscales de gran envergadura requiere tanto destreza arquitectónica como control predictivo de riesgos, cronogramas y requerimientos de calidad.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href="/sobre-mi"
              class="inline-flex items-center text-sm font-bold text-accent hover:underline"
            >
              Conocer trayectoria completa y experiencia laboral →
            </a>
          </div>
        </div>

        <!-- Tarjeta de Certificación PMI -->
        <div class="lg:col-span-5 p-6 rounded-2xl border border-accent/30 bg-surface shadow-md">
          <div class="flex items-start gap-4">
            <div class="p-3 rounded-xl bg-accent/10 text-accent shrink-0">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div>
              <span class="text-xs font-mono font-bold text-success uppercase">Credencial Oficial</span>
              <h3 class="text-lg font-bold text-text-main mt-0.5">{pmiCert.name}</h3>
              <p class="text-xs text-text-muted mt-1">{pmiCert.issuer}</p>
              <div class="mt-3 pt-3 border-t border-border flex flex-wrap items-center justify-between text-xs font-mono">
                <span class="text-text-muted">Licencia: <strong class="text-text-main">{pmiCert.credentialId}</strong></span>
                <a
                  href={pmiCert.verificationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent hover:underline font-medium"
                >
                  Verificar en Certiport ↗
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Banner de Contacto Directo -->
  <section class="py-16 sm:py-20" aria-label="Llamada a la acción de contacto">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-12 rounded-3xl bg-surface border border-border shadow-xl text-center max-w-3xl mx-auto space-y-6">
        <h2 class="text-2xl sm:text-3xl font-black text-text-main tracking-tight">
          ¿Tienes un reto de ingeniería, streaming o integración tributaria?
        </h2>
        <p class="text-sm sm:text-base text-text-muted">
          Disponible para proyectos de alta complejidad, consultorías técnicas en microservicios, optimización de bases de datos Oracle SQL y arquitecturas de datos.
        </p>
        <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
          <a
            href={`mailto:${portfolioData.contact.email}`}
            class="px-6 py-3 rounded-xl bg-accent text-bg font-bold text-sm sm:text-base hover:bg-accent-hover transition-colors shadow-md focus-visible:outline-accent"
          >
            Enviar Correo ({portfolioData.contact.email})
          </a>
          <a
            href="/contacto"
            class="px-6 py-3 rounded-xl bg-surface-hover border border-border text-text-main font-semibold text-sm sm:text-base hover:bg-surface transition-colors focus-visible:outline-accent"
          >
            Ver Canales de Contacto
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

