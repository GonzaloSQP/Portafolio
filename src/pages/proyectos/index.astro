---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { portfolioData } from '../../data/portfolioData';

// Orden prioritario por peso técnico y de arquitectura
const flagshipProjects = portfolioData.projects.slice(0, 2);
const productionProjects = portfolioData.projects.slice(2);
---

<BaseLayout
  title={`Proyectos y Casos de Estudio | ${portfolioData.name}`}
  description="Catálogo de proyectos de arquitectura de software, migración a microservicios con streaming y plataformas tributarias a gran escala."
  currentPath="/proyectos"
>
  <div class="py-12 sm:py-16">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- Encabezado de página -->
      <div class="max-w-3xl">
        <span class="text-xs font-mono text-accent font-semibold tracking-wider uppercase">
          Portafolio de Ingeniería & Arquitectura
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-text-main tracking-tight mt-1">
          Proyectos & Sistemas Críticos
        </h1>
        <p class="mt-4 text-base sm:text-lg text-text-muted leading-relaxed">
          Sistemas en producción, migraciones críticas de bases de datos masivas y microservicios de alta concurrencia desarrollados con estándares rigurosos de fiabilidad y rendimiento.
        </p>
      </div>

      <!-- Sección 1: Casos de Estudio Insignia (Top 2) -->
      <section class="space-y-6" aria-labelledby="flagship-title">
        <div class="flex items-center gap-2 border-b border-border pb-3">
          <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
          <h2 id="flagship-title" class="text-lg sm:text-xl font-bold font-mono text-text-main uppercase tracking-wider">
            Casos de Estudio Principales & Arquitecturas Complejas
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {flagshipProjects.map((project) => (
            <div class="relative">
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </section>

      <!-- Sección 2: Servicios y Productos en Producción -->
      <section class="space-y-6 pt-4" aria-labelledby="production-title">
        <div class="flex items-center gap-2 border-b border-border pb-3">
          <span class="w-2.5 h-2.5 rounded-full bg-success"></span>
          <h2 id="production-title" class="text-lg sm:text-xl font-bold font-mono text-text-main uppercase tracking-wider">
            Sistemas Activos & Plataformas Web en Producción
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {productionProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
