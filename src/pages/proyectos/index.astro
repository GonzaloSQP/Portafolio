---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { portfolioData } from '../../data/portfolioData';

// Orden prioritario por peso técnico y de arquitectura
const flagshipProjects = portfolioData.projects.slice(0, 2);
const productionProjects = portfolioData.projects.slice(2);
---

<BaseLayout
  title={`Proyectos y Casos de Estudio | ${portfolioData.name}`}
  description="Catálogo de proyectos de arquitectura de software, migración a microservicios con streaming y plataformas tributarias a gran escala."
  currentPath="/proyectos"
>
  <div class="py-10 sm:py-14">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Encabezado de página recto -->
      <div class="max-w-3xl space-y-2 border-b border-border pb-6">
        <span class="text-xs font-mono text-accent font-bold tracking-wider uppercase">
          [ PORTAFOLIO DE INGENIERÍA & ARQUITECTURA ]
        </span>
        <h1 class="text-2xl sm:text-4xl lg:text-[40px] font-black text-text-main tracking-tight leading-tight">
          Proyectos & Sistemas Críticos
        </h1>
        <p class="text-sm sm:text-base text-text-muted leading-relaxed font-sans pt-1">
          Sistemas en producción, migraciones críticas de bases de datos masivas y microservicios de alta concurrencia desarrollados con estándares rigurosos de fiabilidad y rendimiento.
        </p>
      </div>

      <!-- Sección 1: Casos de Estudio Insignia (Top 2) -->
      <section class="space-y-4" aria-labelledby="flagship-title">
        <div class="flex items-center gap-2 border-b border-border pb-2.5">
          <span class="w-1.5 h-1.5 bg-accent"></span>
          <h2 id="flagship-title" class="text-xs font-mono font-bold text-accent uppercase tracking-wider">
            [ CASOS DE ESTUDIO PRINCIPALES // ALTA COMPLEJIDAD ]
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {flagshipProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>

      <!-- Sección 2: Servicios y Productos en Producción -->
      <section class="space-y-4 pt-4" aria-labelledby="production-title">
        <div class="flex items-center gap-2 border-b border-border pb-2.5">
          <span class="w-1.5 h-1.5 bg-success"></span>
          <h2 id="production-title" class="text-xs font-mono font-bold text-success uppercase tracking-wider">
            [ SERVICIOS ACTIVOS & PLATAFORMAS EN PRODUCCIÓN ]
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {productionProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
